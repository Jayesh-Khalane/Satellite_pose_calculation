import pyzed.sl as sl
import open3d as o3d
import numpy as np

def main():
    # Initialize ZED camera
    zed = sl.Camera()
    init_params = sl.InitParameters()
    init_params.camera_resolution = sl.RESOLUTION.HD720
    init_params.coordinate_units = sl.UNIT.METER
    init_params.depth_mode = sl.DEPTH_MODE.NEURAL_PLUS

    if zed.open(init_params) != sl.ERROR_CODE.SUCCESS:
        print("Failed to open ZED camera")
        return

    point_cloud = sl.Mat()

    # Open3D visualizer
    vis = o3d.visualization.Visualizer()
    vis.create_window("ZED2i Point Cloud", width=1280, height=720)
    pcd = o3d.geometry.PointCloud()
    geom_added = False

    opt = vis.get_render_option()
    opt.background_color = np.asarray([0, 0, 0])
    opt.point_size = 1.5

    try:
        while True:
            if zed.grab() == sl.ERROR_CODE.SUCCESS:
                # Retrieve XYZRGBA
                zed.retrieve_measure(point_cloud, sl.MEASURE.XYZRGBA)
                pc_np = point_cloud.get_data()  # shape: (H, W, 4), float32

                # Extract XYZ and convert to left-hand Y-up
                xyz = pc_np[:, :, :3].reshape(-1, 3)
                xyz_lh = np.zeros_like(xyz)
                xyz_lh[:, 0] = xyz[:, 0]      # X stays
                xyz_lh[:, 1] = xyz[:, 2]      # Y = Z
                xyz_lh[:, 2] = -xyz[:, 1]     # Z = -Y
                xyz = xyz_lh

                # Filter invalid points
                valid = np.isfinite(xyz).all(axis=1)
                xyz = xyz[valid]

                # Extract color
                rgba_float = pc_np[:, :, 3].reshape(-1)[valid]
                rgba_int = rgba_float.view(np.uint32)
                r = ((rgba_int >> 0) & 0xFF).astype(np.uint8)
                g = ((rgba_int >> 8) & 0xFF).astype(np.uint8)
                b = ((rgba_int >> 16) & 0xFF).astype(np.uint8)
                colors = np.stack([r, g, b], axis=1) / 255.0

                # Optional downsampling for speed
                if xyz.shape[0] > 100000:
                    idx = np.random.choice(xyz.shape[0], 100000, replace=False)
                    xyz = xyz[idx]
                    colors = colors[idx]

                # Update Open3D point cloud
                pcd.points = o3d.utility.Vector3dVector(xyz)
                pcd.colors = o3d.utility.Vector3dVector(colors)

                if not geom_added:
                    vis.add_geometry(pcd)
                    geom_added = True

                vis.update_geometry(pcd)
                vis.poll_events()
                vis.update_renderer()

    except KeyboardInterrupt:
        print("Exiting...")

    finally:
        zed.close()
        vis.destroy_window()


if __name__ == "__main__":
    main()
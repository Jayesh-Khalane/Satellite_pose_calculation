import pyzed.sl as sl
import numpy as np
from vispy import app, scene

# --------------------------
# ZED Camera Setup
# --------------------------
zed = sl.Camera()
init_params = sl.InitParameters()
init_params.depth_mode = sl.DEPTH_MODE.NEURAL
init_params.coordinate_units = sl.UNIT.METER
init_params.camera_resolution = sl.RESOLUTION.HD720

status = zed.open(init_params)
if status != sl.ERROR_CODE.SUCCESS:
    print("Failed to open ZED camera")
    exit()

runtime_params = sl.RuntimeParameters()
pc_mat = sl.Mat()

# --------------------------
# Vispy Scene Setup
# --------------------------
canvas = scene.SceneCanvas(keys='interactive', show=True, bgcolor='black', title="ZED2i Live PointCloud")
view = canvas.central_widget.add_view()

# Arcball camera (Open3D/PyVista style)
view.camera = scene.cameras.ArcballCamera(fov=60, distance=2.0, center=(0, 0, 0))
# Flip axes to LEFT-hand Y-up orientation: X right, Y up, Z forward
view.camera.flip = (False, True, False)

scatter = scene.visuals.Markers(parent=view.scene)
scatter.antialias = 0
scatter.set_gl_state('translucent', depth_test=True)
scatter.set_data(np.zeros((1,3)), face_color=(1,1,1,1), size=2)

# --------------------------
# Performance tuning
# --------------------------
DOWNSAMPLE = 5  # Adjust for FPS

MAX_DISTANCE = 2.0  # meters

# --------------------------
# Update Function
# --------------------------
def update(ev):
    if zed.grab(runtime_params) == sl.ERROR_CODE.SUCCESS:
        zed.retrieve_measure(pc_mat, sl.MEASURE.XYZRGBA)
        pc_np = pc_mat.get_data()

        # Extract XYZ
        xyz = pc_np[:, :, :3].reshape(-1, 3)
        mask = np.isfinite(xyz).all(axis=1)

        # Filter points < MAX_DISTANCE
        distances = np.linalg.norm(xyz, axis=1)
        mask = mask & (distances < MAX_DISTANCE)

        xyz = xyz[mask][::DOWNSAMPLE]

        # Extract RGB
        rgba_floats = pc_np[:, :, 3].reshape(-1)[mask][::DOWNSAMPLE]
        rgba_bits = rgba_floats.view(np.uint32)
        r = ((rgba_bits >> 0) & 0xFF) / 255.0
        g = ((rgba_bits >> 8) & 0xFF) / 255.0
        b = ((rgba_bits >> 16) & 0xFF) / 255.0
        colors = np.column_stack((r, g, b, np.ones_like(r)))

        # Update scatter
        scatter.set_data(xyz, face_color=colors, size=5)

# --------------------------
# Timer for live updates
# --------------------------
timer = app.Timer()
timer.connect(update)
timer.start(0.03)  # ~30 FPS

# --------------------------
# Run Vispy App
# --------------------------
try:
    app.run()
finally:
    zed.close()